# ScrowX Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is listed in .gitignore.

# ── Database ────────────────────────────────────────────────────────────────
# Local development database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/scrowx_dev"

# Production database (e.g. Railway, Supabase, Neon)
PROD_DATABASE_URL="postgresql://USER:PASSWORD@host:PORT/dbname"

# ── API ─────────────────────────────────────────────────────────────────────
# Frontend API base URL (Vite)
VITE_API_URL=http://localhost:3000

# xAI Grok API key — generate at: https://console.x.ai
GROK_API_KEY="xai-your-api-key-here"

# ── AI Providers ──────────────────────────────────────────────────────────────
# Google Gemini API key — generate at: https://aistudio.google.com/app/apikeys
# Used by BOTH gemini-3.5-flash (primary) and gemini-3.5-flash-lite (fallback).
# Same key — separate rate-limit buckets per model:
#   gemini-3.5-flash:      5 RPM  / 20 RPD  (free tier)
#   gemini-3.5-flash-lite: 15 RPM / 500 RPD (free tier) — the real working fallback today
GEMINI_API_KEY="your-gemini-api-key-here"

# Anthropic Claude API key — generate at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# ── Auth ─────────────────────────────────────────────────────────────────────
# JWT signing secret — use a long random string (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-random-secret-here"
